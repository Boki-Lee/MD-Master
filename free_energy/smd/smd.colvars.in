# SMD 拉伸 colvars 模板
# @ION@ / @OX@ 会被 run_smd.sh 用 build 产物（ion_index.dat / ox_indices.dat）替换
colvarsTrajFrequency 500
colvarsRestartFrequency 5000

# 反应坐标：目标离子相对目标孔（6 个冠醚氧）的 Z 方向距离（孔心=0，管外为正，管内为负）
colvar {
  name z_dist
  distanceZ {
    main { atomNumbers { @ION@ } }
    ref  { atomNumbers { @OX@ } }
  }
}

# SMD：把 z_dist 从 +12（管外体相）匀速拉到 -6（管内）
# ⚠️ centers / targetCenters 必须【覆盖 us/windows.txt 里窗口的整个 z 范围】，
#    两端各留 1 Å 余量，否则提取窗口构象时会找不到对应的帧。
#    默认给的是宽量程 12 -> -6，能覆盖窄量程（±5 Å）那份窗口清单，
#    只是 SMD 会多跑一段用不到的路程（1 ns 量级，可忽略）；
#    若确定只用窄量程，改成 centers 6.0 / targetCenters -6.0 可以省一半时间。
harmonic {
  name pull_z
  colvars z_dist
  forceConstant 250.0     # kcal/mol/A^2，强弹簧拉过脱水势垒（可调）
  centers 12.0
  targetCenters -6.0
  targetNumSteps 1000000
}
